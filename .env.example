# PostgreSQL used by the FastAPI backend. The Docker Compose defaults below match
# this URL; change these values together if you customize the database service.
DATABASE_URL=postgresql+psycopg://gmail_manager:replace-with-a-long-random-database-password@localhost:5432/gmail_manager

# Application configuration. Do not use these development values in production.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-development-secret
LOCAL_AUTH_PASSWORD=replace-with-a-long-random-local-password

# Used only by Docker Compose. Generate a unique value and use the same value
# in DATABASE_URL above.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# The one local application user provisioned during Milestone 2. This is not a
# Gmail account and does not grant Gmail access.
LOCAL_OWNER_EMAIL=local-owner@localhost
LOCAL_OWNER_DISPLAY_NAME=Local Owner

# Added in milestone 3, after the Gmail OAuth flow is implemented.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback
FRONTEND_URL=http://localhost:3000

# Public backend URL used by the Next.js development server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
